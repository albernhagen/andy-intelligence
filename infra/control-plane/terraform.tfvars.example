# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real file.
allowed_emails = ["you@example.com"]
alert_email    = "you@example.com"
# Needs-you email (AI-77): keep email_enabled false until the Resend key's version exists (runbook email-notifications.md).
email_enabled = false
email_from = "" # e.g. "andy-intelligence <notify@example.com>"
email_to   = "" # e.g. "you@example.com"
# Web Push (AI-179): keep push_enabled false until the VAPID private key's version exists (runbook mobile.md).
push_enabled     = false
vapid_public_key = "" # the public half from `npx web-push generate-vapid-keys`; public, not a secret
