    { "path": "AGENTS.md", "from": "template/AGENTS.md" },
    { "path": "docs/security/threat-model.md", "from": "template/docs/security/threat-model.md" }
  ],
  "starter": [
    { "path": "package.json", "from": "template/starter/package.json.template" },
    { "path": ".nvmrc", "from": "template/starter/.nvmrc" },
    { "path": "tsconfig.json", "from": "template/starter/tsconfig.json.template" },
    { "path": "eslint.config.js", "from": "template/starter/eslint.config.js.template" },
    { "path": ".prettierignore", "from": "template/starter/.prettierignore" },
    { "path": "src/index.ts", "from": "template/starter/src/index.ts" },
    { "path": "src/index.test.ts", "from": "template/starter/src/index.test.ts" }
  ]
