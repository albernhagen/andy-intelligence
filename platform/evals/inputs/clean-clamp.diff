+++ b/packages/domain/src/clamp.ts
@@ -0,0 +1,8 @@
+/** `value` limited to [min, max]; throws on NaN, an empty range or a bound that is not finite. */
+export function clamp(value: number, min: number, max: number): number {
+  if (Number.isNaN(value)) throw new RangeError("value is NaN");
+  if (!Number.isFinite(min) || !Number.isFinite(max) || min > max) {
+    throw new RangeError(`empty range [${min}, ${max}]`);
+  }
+  return Math.min(max, Math.max(min, value));
+}
