@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { clamp } from "./clamp";
+
+describe("clamp", () => {
+  it("GivenAValueInsideTheRange_WhenClamped_ThenUnchanged", () => {
+    expect(clamp(5, 0, 10)).toBe(5);
+    expect(clamp(0, 0, 10)).toBe(0);
+    expect(clamp(10, 0, 10)).toBe(10);
+  });
+
+  it("GivenAValueOutsideTheRange_WhenClamped_ThenTheNearestBound", () => {
+    expect(clamp(-1, 0, 10)).toBe(0);
+    expect(clamp(11, 0, 10)).toBe(10);
+    expect(clamp(Number.NEGATIVE_INFINITY, 0, 10)).toBe(0);
+  });
+
+  it("GivenNaNOrAnEmptyOrNonFiniteRange_WhenClamped_ThenThrows", () => {
+    expect(() => clamp(Number.NaN, 0, 10)).toThrow(RangeError);
+    expect(() => clamp(1, 10, 0)).toThrow(RangeError);
+    expect(() => clamp(1, Number.NaN, 0)).toThrow(RangeError);
+    expect(() => clamp(1, 0, Number.POSITIVE_INFINITY)).toThrow(RangeError);
+  });
+
+  it("GivenAOneValueRange_WhenClamped_ThenThatValue", () => {
+    expect(clamp(-3, 4, 4)).toBe(4);
+  });
+});
