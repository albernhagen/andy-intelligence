{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "One or two sentences: what was reviewed and the overall verdict."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "kind": {
            "type": "string",
            "enum": [
              "logic-error",
              "edge-case",
              "missing-test",
              "missing-docs",
              "contract-drift",
              "spec-gap",
              "unbounded",
              "injection",
              "authz",
              "secret-exposure",
              "unsafe-workflow",
              "dependency",
              "concurrency",
              "other"
            ],
            "description": "The category of the finding, one from this list (other when none fits). Repeated kinds across PRs become proposed agent rules (ADR-0097)."
          },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "description": {
            "type": "string",
            "description": "What is wrong and how it could be exploited."
          },
          "recommendation": { "type": "string" }
        },
        "required": ["severity", "kind", "title", "description", "recommendation"]
      }
    }
  },
  "required": ["summary", "findings"]
}
