{
  "name": "andy-intelligence",
  "description": "andy-intelligence control plane: records PR, check and workflow events for registered projects (ADR-0041).",
  "url": "https://github.com/albernhagen/andy-intelligence",
  "hook_attributes": {
    "url": "https://control-plane-662512537397.us-central1.run.app/webhooks/github",
    "active": true
  },
  "redirect_url": "http://localhost:1/",
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "read",
    "checks": "read",
    "actions": "read"
  },
  "default_events": ["pull_request", "check_run", "workflow_run"]
}
